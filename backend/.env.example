# Server
PORT=5000/8080
NODE_ENV=development/production

# Auth - node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=


# Database
MONGO_URI=

#Email info 
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookies
COOKIE_SECURE=false/true
COOKIE_SAMESITE=strict/none(production)

# Google sign-in (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID -> Web application)
# Authorized JavaScript origins: http://localhost:3000 (and your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admins. Comma separated Google emails. Only these can sign in until they add the rest.
ADMIN_EMAILS=

# Seed Admin (used with `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Rate limiting (set to "false" to disable, e.g. during local testing)
RATE_LIMIT_ENABLED=false/true(production)